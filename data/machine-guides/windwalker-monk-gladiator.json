  "sections": [
    {
      "kind": "text",
      "title": "Why the burst sits inside Zenith",
      "body": "Zenith resets Rising Sun Kick and cuts every chi cost by 1 for 15s, so his chi spenders cluster inside it: 70% of his Strike of the Windlords, 60% of his Fists of Fury. The free buttons come from procs: Dance of Chi-Ji made 57% of his Spinning Crane Kicks free, and Blackout Kick! 79% of his Blackout Kicks. Hit Combo pays for never pressing the same button twice."
    },
    {
      "kind": "sequence",
      "title": "Setup: crowd control before Zenith",
      "steps": [
        {
          "spec": "monk/windwalker",
          "spell": "Paralysis",
          "note": "Before 11 of 18 Zeniths."
        },
        {
          "spec": "monk/windwalker",
          "spell": "Ring of Peace",
          "note": "Before Leg Sweep 6 times, about 2s earlier."
        },
        {
          "spec": "monk/windwalker",
          "spell": "Leg Sweep",
          "note": "0.9s before Zenith, 7 of 18 times: the burst opens on a stunned target."
        }
      ]
    },
    {
      "kind": "sequence",
      "title": "Burst: offensive cooldowns, pressed together",
      "steps": [
        {
          "spec": "monk/windwalker",
          "spell": "Zenith",
          "note": "Resets Rising Sun Kick; every chi cost -1 for 15s. 18 in 7 games."
        },
        {
          "spec": "monk/windwalker",
          "spell": "Strike of the Windlord",
          "note": "70% inside Zenith, where it costs a chi less. 6% of his damage."
        },
        {
          "spec": "monk/windwalker",
          "spell": "Fists of Fury",
          "note": "Within 5s of Zenith, 9 of 18. Turbo Fists: slows 90% and parries meanwhile."
        },
        {
          "spec": "monk/windwalker",
          "spell": "Touch of Death",
          "note": "The finish at 3-9% health. Not burst."
        }
      ]
    },
    {
      "kind": "sequence",
      "title": "Burst: what fills it, and why then",
      "steps": [
        {
          "spec": "monk/windwalker",
          "spell": "Rising Sun Kick",
          "note": "Straight into Zenith, which resets it. 14% of his damage."
        },
        {
          "spec": "monk/windwalker",
          "spell": "Spinning Crane Kick",
          "note": "Free 57% of the time (Dance of Chi-Ji). His biggest source: 17%."
        },
        {
          "spec": "monk/windwalker",
          "spell": "Blackout Kick",
          "note": "Free 79% of the time: Blackout Kick! from Tiger Palm or a free Crane Kick."
        },
        {
          "spec": "monk/windwalker",
          "spell": "Tiger Palm",
          "note": "At full energy 67% of the time: spends it before it caps, builds chi."
        },
        {
          "spec": "monk/windwalker",
          "spell": "Rushing Wind Kick",
          "note": "Only pressed when it procs. 8% of his damage."
        }
