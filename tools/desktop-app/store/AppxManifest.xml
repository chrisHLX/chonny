<?xml version="1.0" encoding="utf-8"?>
<!--
  The Microsoft Store package (2026-10-19). Identity, Publisher and PublisherDisplayName are the
  values Partner Center assigned (MindCollector > Product identity); they must match it exactly or
  the upload is refused. {VERSION} is filled from the csproj by build-store.ps1.

  runFullTrust: a WinForms app reading WoW's combat log folder and writing the addon into WoW's
  AddOns folder needs ordinary desktop file access, which a restricted (UWP) app does not have.
  The startup task replaces the downloaded app's registry Run key (StoreStartup.cs).
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap desktop rescap">

  <Identity
    Name="MindCollector.MindCollector"
    Publisher="CN=CE0FFBCD-CDE8-41A8-9846-E153822FC535"
    Version="{VERSION}"
    ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>MindCollector</DisplayName>
    <PublisherDisplayName>MindCollector</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Applications>
    <Application Id="MindCollector" Executable="MindCollector.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="MindCollector"
        Description="Sends your WoW arena games to mindcollector.com and shows each one reviewed."
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" Square310x310Logo="Assets\Square310x310Logo.png" Square71x71Logo="Assets\Square71x71Logo.png" />
      </uap:VisualElements>
      <Extensions>
        <desktop:Extension Category="windows.startupTask" Executable="MindCollector.exe" EntryPoint="Windows.FullTrustApplication">
          <desktop:StartupTask TaskId="MindCollectorStartup" Enabled="true" DisplayName="MindCollector" />
        </desktop:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <Capability Name="internetClient" />
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
