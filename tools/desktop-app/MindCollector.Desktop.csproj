<Project Sdk="Microsoft.NET.Sdk">

  <!--
    MindCollector, the downloadable desktop app: reads a player's combat log, sends finished arena
    rounds to mindcollector.com with the player's key, and shows the pages the server builds.
    Needs no copy of this project, no PHP and no database. See README.md.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- The Windows 10 target (2026-11-06) reaches Windows.Media.Transcoding, which cuts each WoW
         Forever clip down to its fight (ClipCutter); the Store build already used it. -->
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>MindCollector.Desktop</RootNamespace>
    <AssemblyName>MindCollector</AssemblyName>
    <ApplicationIcon>mindcollector.ico</ApplicationIcon>
    <Version>0.6.11</Version>
    <Product>MindCollector</Product>
    <Company>MindCollector</Company>
    <!-- What Windows shows in the file's Properties and in its install and SmartScreen prompts. -->
    <AssemblyTitle>MindCollector: WoW arena game reviews</AssemblyTitle>
    <Description>Sends your WoW arena games to mindcollector.com and shows each one reviewed.</Description>
    <Copyright>Copyright (c) 2026 MindCollector</Copyright>
    <NeutralLanguage>en</NeutralLanguage>
    <!-- One exe for testers: the .NET runtime is inside it, so nothing else needs installing. -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <!-- 155 MB uncompressed (2026-10-08); compressed inside the exe for sending to testers. -->
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <!--
    The Microsoft Store build (2026-10-19): `dotnet publish -p:Store=true`, packaged by
    store/build-store.ps1. The Store signs it, so Windows trusts it, and keeps it up to date, so
    the STORE constant leaves out the self-install (Installer) and the self-update (Updater), and
    starting with Windows is the package's StartupTask instead of the registry Run key, which a
    packaged app cannot rely on. The Windows 10 target is what reaches the StartupTask API.
    A folder, not one exe: the package itself is the single file.
  -->
  <PropertyGroup Condition="'$(Store)' == 'true'">
    <DefineConstants>$(DefineConstants);STORE</DefineConstants>
    <PublishSingleFile>false</PublishSingleFile>
    <EnableCompressionInSingleFile>false</EnableCompressionInSingleFile>
    <IncludeNativeLibrariesForSelfExtract>false</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="mindcollector.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- The arena-log addon, built in from its one copy in the repo, so the app can install it
       (AddonInstaller). Edit it in tools/wow-addon, never here. -->
  <ItemGroup>
    <EmbeddedResource Include="..\wow-addon\MindCollectorArenaLog\MindCollectorArenaLog.toc" LogicalName="addon/MindCollectorArenaLog.toc" />
    <EmbeddedResource Include="..\wow-addon\MindCollectorArenaLog\main.lua" LogicalName="addon/main.lua" />
    <!-- WoW Forever's addon (2026-11-06): keeps logging on so ForeverRecorder sees each PvP fight. -->
    <EmbeddedResource Include="..\wow-addon\MindCollectorForeverLog\MindCollectorForeverLog.toc" LogicalName="forever-addon/MindCollectorForeverLog.toc" />
    <EmbeddedResource Include="..\wow-addon\MindCollectorForeverLog\main.lua" LogicalName="forever-addon/main.lua" />
    <!-- WoW Forever's Observer addon (2026-11-09): what the player looks at, and /ask. Answers.lua is
         installed only when missing, since AskBridge writes it (AddonInstaller.Observer). -->
    <EmbeddedResource Include="..\wow-addon\MindCollectorObserver\MindCollectorObserver.toc" LogicalName="observer-addon/MindCollectorObserver.toc" />
    <EmbeddedResource Include="..\wow-addon\MindCollectorObserver\Data.lua" LogicalName="observer-addon/Data.lua" />
    <EmbeddedResource Include="..\wow-addon\MindCollectorObserver\Answers.lua" LogicalName="observer-addon/Answers.lua" />
    <EmbeddedResource Include="..\wow-addon\MindCollectorObserver\Market.lua" LogicalName="observer-addon/Market.lua" />
    <EmbeddedResource Include="..\wow-addon\MindCollectorObserver\main.lua" LogicalName="observer-addon/main.lua" />
    <EmbeddedResource Include="..\wow-addon\MindCollectorObserver\ui.lua" LogicalName="observer-addon/ui.lua" />
    <EmbeddedResource Include="..\wow-addon\MindCollectorObserver\ask.lua" LogicalName="observer-addon/ask.lua" />
    <!-- Forever's recipe facts for /ask (AskBridge.ItemFacts), from tools/forever-ask/build_item_facts.py. -->
    <EmbeddedResource Include="..\forever-ask\item_facts.json" LogicalName="ask/item_facts.json" />
  </ItemGroup>

</Project>
